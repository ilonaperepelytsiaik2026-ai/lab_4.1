#include <iostream>
#include <cmath>

using namespace std;

int main()
{
    int k, N;   // k - змінна циклу (індекс суми), N - верхня межа суми
    double S;   // S - значення суми

    cout << "Enter N: ";
    cin >> N;

    if (N < 1)
    {
        cout << "N must be >= 1" << endl;
        return 1;
    }

    // Спосіб 1: цикл while
    S = 0;
    k = 1;
    while (k <= N)
    {
        S += (1 + sqrt(1. + 1. * k * k)) / (1. * k * k);
        k++;
    }
    cout << "S (while)         = " << S << endl;

    // Спосіб 2: цикл do-while
    S = 0;
    k = 1;
    do
    {
        S += (1 + sqrt(1. + 1. * k * k)) / (1. * k * k);
        k++;
    } while (k <= N);
    cout << "S (do-while)      = " << S << endl;

    // Спосіб 3: цикл for з k++
    S = 0;
    for (k = 1; k <= N; k++)
    {
        S += (1 + sqrt(1. + 1. * k * k)) / (1. * k * k);
    }
    cout << "S (for, k++)      = " << S << endl;

    // Спосіб 4: цикл for з k--
    S = 0;
    for (k = N; k >= 1; k--)
    {
        S += (1 + sqrt(1. + 1. * k * k)) / (1. * k * k);
    }
    cout << "S (for, k--)      = " << S << endl;

    return 0;
}
